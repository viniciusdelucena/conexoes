rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function membroDaCasa(casaId) {
      return logado()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(casaId)).data.members;
    }

    // Cada pessoa lê e grava apenas o próprio perfil (guarda a qual casa pertence).
    match /users/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // Casa compartilhada. O ID da casa é o código de convite.
    match /households/{casaId} {
      // Quem sabe o código consegue abrir o documento para entrar (listar é proibido).
      allow get: if logado();

      // Criar: a pessoa precisa ser o único membro inicial.
      allow create: if logado()
        && request.resource.data.members == [request.auth.uid];

      // Atualizar: membros podem editar; quem não é membro só pode se adicionar
      // (e apenas se a casa tiver menos de 2 pessoas).
      allow update: if logado() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.size() <= 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if false;

      // Dívidas, contas, gastos etc. (fases seguintes): só membros da casa.
      match /{documento=**} {
        allow read, write: if membroDaCasa(casaId);
      }
    }
  }
}
